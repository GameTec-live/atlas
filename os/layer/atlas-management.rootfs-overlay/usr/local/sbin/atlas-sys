#!/bin/sh
set -eu

socket=${ATLAS_SYS_SOCKET:-/run/atlas-management/api.sock}
token_file=${ATLAS_SYS_TOKEN_FILE:-/home/atlas-containers/.config/atlas/management-token}
curl_command=${ATLAS_SYS_CURL:-/usr/bin/curl}

die() {
    echo "atlas-sys: $*" >&2
    exit 1
}

usage() {
    cat >&2 <<'EOF'
usage: atlas-sys COMMAND

Commands:
  status                         Show service, A/B update and trial health state
  update apply BUNDLE            Upload, install and tryboot an update bundle
  update rollback                Roll back or clear the pending update
  reboot                         Reboot the device
  poweroff                       Power off the device
  ssh status                     Show persistent SSH policy
  ssh enable                     Persistently enable SSH
  ssh disable                    Persistently disable SSH
  timezone status                Show the system and database timezone
  timezone set TIMEZONE          Set an IANA timezone (for example Europe/Vienna)
  remote-access status           Show Cloudflare Tunnel and Tailscale state
  cloudflare-tunnel provision TOKEN_FILE
                                 Provision and start a Cloudflare Tunnel
  cloudflare-tunnel remove       Stop and remove the Cloudflare Tunnel
  tailscale provision AUTH_KEY_FILE [HOSTNAME]
                                 Provision and start Tailscale
  tailscale remove               Stop and remove Tailscale
  factory-reset [--yes]          Erase mutable data and configuration

Use - as a credential file to read the token or auth key from stdin.
EOF
    exit 2
}

require_root() {
    [ "$(id -u)" -eq 0 ] || die "must run as root (use sudo atlas-sys ...)"
}

token() {
    [ -r "$token_file" ] || die "management token is unavailable: $token_file"
    value=$(tr -d '\r\n' < "$token_file")
    [ -n "$value" ] || die "management token is empty"
    printf '%s' "$value"
}

request() {
    method=$1
    path=$2
    shift 2
    [ -S "$socket" ] || die "management socket is unavailable: $socket"
    "$curl_command" \
        --silent \
        --show-error \
        --fail-with-body \
        --unix-socket "$socket" \
        --header "Authorization: Bearer $(token)" \
        --request "$method" \
        "$@" \
        "http://localhost$path"
    printf '\n'
}

request_json() {
    method=$1
    path=$2
    request "$method" "$path" \
        --header 'Content-Type: application/json' \
        --data-binary @-
}

read_credential() {
    path=$1
    label=$2
    if [ "$path" = - ]; then
        value=$(tr -d '\r')
    else
        [ -f "$path" ] || die "$label file does not exist: $path"
        [ -r "$path" ] || die "$label file is not readable: $path"
        value=$(tr -d '\r' < "$path")
    fi
    case "$value" in
        ''|*[!A-Za-z0-9._=+/-]*) die "$label contains invalid characters" ;;
    esac
    printf '%s' "$value"
}

validate_hostname() {
    case "$1" in
        ''|*[!A-Za-z0-9.-]*) die "hostname must be a DNS name" ;;
    esac
}

validate_timezone() {
    case "$1" in
        ''|/*|.|..|./*|../*|*/.|*/..|*//*|*[!A-Za-z0-9_+/-]*)
            die "timezone must be an IANA timezone name"
            ;;
    esac
}

confirm_factory_reset() {
    if [ "${1:-}" = --yes ]; then
        [ "$#" -eq 1 ] || usage
        return
    fi
    [ "$#" -eq 0 ] || usage
    [ -t 0 ] || die "factory reset requires an interactive terminal or --yes"
    echo "This erases all Atlas data, credentials and network configuration." >&2
    printf 'Type RESET to continue: ' >&2
    IFS= read -r confirmation
    [ "$confirmation" = RESET ] || die "factory reset cancelled"
}

require_root

case "${1:-}" in
    status)
        [ "$#" -eq 1 ] || usage
        printf 'management=%s\n' "$(systemctl is-active atlas-management.service 2>/dev/null || true)"
        request GET /api/v1/update
        request GET /api/v1/connections/remote-access
        ;;
    update)
        case "${2:-}" in
            apply)
                [ "$#" -eq 3 ] || usage
                bundle=$3
                [ -f "$bundle" ] || die "update bundle does not exist: $bundle"
                request POST /api/v1/update --form "bundle=@$bundle"
                ;;
            rollback)
                [ "$#" -eq 2 ] || usage
                request POST /api/v1/update/rollback
                ;;
            *) usage ;;
        esac
        ;;
    reboot)
        [ "$#" -eq 1 ] || usage
        request POST /api/v1/power/reboot
        ;;
    poweroff)
        [ "$#" -eq 1 ] || usage
        request POST /api/v1/power/poweroff
        ;;
    ssh)
        case "${2:-}" in
            status)
                [ "$#" -eq 2 ] || usage
                request GET /api/v1/ssh
                ;;
            enable)
                [ "$#" -eq 2 ] || usage
                request POST /api/v1/ssh/enable
                ;;
            disable)
                [ "$#" -eq 2 ] || usage
                request POST /api/v1/ssh/disable
                ;;
            *) usage ;;
        esac
        ;;
    timezone)
        case "${2:-}" in
            status)
                [ "$#" -eq 2 ] || usage
                request GET /api/v1/timezone
                ;;
            set)
                [ "$#" -eq 3 ] || usage
                validate_timezone "$3"
                printf '{"timezone":"%s"}' "$3" | request_json PUT /api/v1/timezone
                ;;
            *) usage ;;
        esac
        ;;
    remote-access)
        if [ "${2:-}" != status ] || [ "$#" -ne 2 ]; then
            usage
        fi
        request GET /api/v1/connections/remote-access
        ;;
    cloudflare-tunnel)
        case "${2:-}" in
            provision)
                [ "$#" -eq 3 ] || usage
                credential=$(read_credential "$3" "Cloudflare Tunnel token")
                printf '{"token":"%s"}' "$credential" | \
                    request_json PUT /api/v1/connections/remote-access/cloudflare-tunnel
                ;;
            remove)
                [ "$#" -eq 2 ] || usage
                request DELETE /api/v1/connections/remote-access/cloudflare-tunnel
                ;;
            *) usage ;;
        esac
        ;;
    tailscale)
        case "${2:-}" in
            provision)
                [ "$#" -eq 3 ] || [ "$#" -eq 4 ] || usage
                credential=$(read_credential "$3" "Tailscale auth key")
                hostname=${4:-}
                if [ -n "$hostname" ]; then
                    validate_hostname "$hostname"
                    printf '{"authKey":"%s","hostname":"%s"}' "$credential" "$hostname" | \
                        request_json PUT /api/v1/connections/remote-access/tailscale
                else
                    printf '{"authKey":"%s"}' "$credential" | \
                        request_json PUT /api/v1/connections/remote-access/tailscale
                fi
                ;;
            remove)
                [ "$#" -eq 2 ] || usage
                request DELETE /api/v1/connections/remote-access/tailscale
                ;;
            *) usage ;;
        esac
        ;;
    factory-reset)
        shift
        confirm_factory_reset "$@"
        request POST /api/v1/factory-reset
        ;;
    *) usage ;;
esac
