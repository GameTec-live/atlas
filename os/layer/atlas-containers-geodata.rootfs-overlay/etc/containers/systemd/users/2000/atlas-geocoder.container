[Unit]
Description=Atlas geocoder
Requires=atlas-container-init.service
After=atlas-container-init.service
# Missing geodata is expected until setup completes. Keep retrying indefinitely.
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/gametec-live/geocoder-go:latest
Pull=missing
AutoUpdate=registry
ContainerName=atlas-geocoder
Network=atlas.network:alias=geocoder
User=65532
Group=65532
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Label=live.gametec.atlas.geodata-consumer=geocoder
Volume=atlas-geodata.volume:/data:ro
Notify=healthy

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=12h

[Install]
WantedBy=default.target
