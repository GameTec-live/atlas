#!/bin/sh
set -eu

configuration_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
root=${ROOTFS_DIR:?pi-gen-micro did not provide ROOTFS_DIR}

install -D -m 0755 "$configuration_dir/atlas-recover" \
    "$root/usr/local/sbin/atlas-recover"

cat > "$root/etc/os-release" <<'EOF'
NAME="AtlasOS Recovery"
ID=atlas-recovery
PRETTY_NAME="AtlasOS Recovery USB"
EOF
